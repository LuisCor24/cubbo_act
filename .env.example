# Plantilla de configuracion. Copiar como ".env" y llenar con valores reales.
# El archivo .env NUNCA se sube a GitHub (esta en .gitignore).
# En GitHub, estos valores van en Settings > Secrets, no en un archivo.

# --- MySQL (la base en la nube) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=cubbo_db
MYSQL_SSL=1

# --- API Cubbo / LastMile ---
CUBBO_API_KEY=

# --- API Routal ---
ROUTAL_PRIVATE_KEY=
ROUTAL_PROJECT_ID=636aaed54235630d2258fa6d

# --- Opcionales (tienen valores por defecto en el codigo) ---
# DIAS_RECIENTES=3
# MAX_DIAS_RANGO=30
# DATE_FROM=
# DATE_TO=
